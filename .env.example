# ════════════════════════════════════════════════════════════════════
#  DJOUSE-TECH-MD · variables d'environnement (EXEMPLE)
#  Copier vers .env puis renseigner. Ce fichier ne contient AUCUNE
#  valeur secrète — ne jamais committer le fichier .env réel.
# ════════════════════════════════════════════════════════════════════

# ── Identité (valeurs par défaut si absentes) ────────────────────────
BOT_NAME=DJOUSSE-TECH-MD
OWNER_NAME=Beaute Gar
SLOGAN=Des solutions fiables pour un avenir sans limites

# ── Owners WhatsApp (séparés par des virgules, format international) ─
# OWNERS=+2376XXXXXXXX,+1XXXXXXXXXX

# ── Modes & connexion ────────────────────────────────────────────────
MODE=public
HYBRID_MODE=on
AGENT_MODE=on
CONNECT_METHOD=pairing
# PAIRING_PHONE=2376XXXXXXXX

# ── Jumelage & session de démarrage ──────────────────────────────────
# BOOT_SESSION=all        # absent/on : démarre « djsession » (historique)
#                         # off       : aucun socket au démarrage
#                         # all/auto  : reprend TOUTES les sessions enregistrées
#                         # session_X : reprend uniquement cette session
# MAX_BOOT_SESSIONS=5     # plafond quand BOOT_SESSION=all
# PAIRING_API=on          # API HTTP de jumelage (port PAIRING_API_PORT, défaut 8089)
# PAIRING_API_PORT=8089
# PAIRING_API_TOKEN=      # OBLIGATOIRE : sans lui /pair répond 503 (aucun jeton par défaut)
# SERVE_SITE=on           # sert aussi web/public sur le port de l'API de jumelage

# ── Base de données (optionnelle — sinon SQLite local dans data/) ────
# BOTS_DATABASE_URL=postgres://user:pass@host:5432/db

# ── Menus & protections (défauts entre parenthèses) ──────────────────
# PREFIX=.
# MENU_PICTURE_MODE=random
# MENU_PICTURE_PATH=assets/anime-profile.jpg
# GUARD_TZ=Africa/Douala

# ── Clés de services IA (facultatives — message propre si absentes) ──
# GEMINI_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# ── Clés de services multimédia (facultatives) ───────────────────────
# SERPER_API_KEY=
# GNEWS_API_KEY=
# ELEVENLABS_API_KEY=
# FOOTBALL_API_KEY=
# IMGBB_KEY=
# GITHUB_TOKEN=

# ── Contrôle d'envoi (lib/envoi) ─────────────────────────────────
# Tous les réglages vivent dans src/config/envoi.json (relu à chaud).
# Les variables ci-dessous sont des SURCHARGES D'URGENCE (prioritaires).
# ENVOI_ACTIF=0            # coupe le contrôle (à éviter : plus de plafond)
# ENVOI_MODE=strict        # opt-in explicite uniquement (défaut : reponse)
# ENVOI_WARMUP=0           # désactive les paliers de montée en charge
# ENVOI_DEGRADE=1          # force l'arrêt des envois
# ENVOI_MAX_MINUTE=20
# ENVOI_MAX_HEURE=200
# ENVOI_MAX_JOUR=500
# ENVOI_DELAI_MIN=250
# ENVOI_JITTER_MAX=1500
# ENVOI_SEL=               # sel HMAC des numéros (32+ caractères, recommandé)
# ENVOI_DASH_TOKEN=        # jeton du dashboard /envoi/* (sinon PAIRING_API_TOKEN)
