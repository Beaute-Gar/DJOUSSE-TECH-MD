{
  "name": "djousse-tech-md",
  "version": "3.0.0",
  "type": "module",
  "description": "DJOUSSE-TECH-MD — WhatsApp Bot with AI, CRM, and Anti-Ban Security",
  "main": "index.cjs",
  "scripts": {
    "start": "node index.cjs",
    "dev": "node index.cjs",
    "apk:build": "node -e \"require('child_process').execSync('scripts\\\\build-apk.bat',{stdio:'inherit',cwd:__dirname})\"",
    "apk:build:sh": "bash scripts/build-apk.sh",
    "apk:build:termux": "bash scripts/build-apk-termux.sh",
    "apk:send": "echo 'Utilisez .apk send dans WhatsApp'",
    "android:init": "npx cap init djousse-tech-md com.djoussetechnology.md --web-dir www",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease",
    "capacitor:init": "npx cap init",
    "capacitor:android": "npx cap add android && npx cap sync android",
    "dashboard": "DASHBOARD_ENABLED=true node index.cjs"
  },
  "dependencies": {
