# DJOUSSE TECH MD sur Replit — worker sans port : la Console affiche
# directement le code d'appairage 8 caractères.
#
#   1. Secrets (Variables d'environnement) : OWNER_NUMBER, PAIRING_PHONE…
#   2. ▶ Run → le code s'imprime dans la Console
#   3. Always On (plan payant) : sans lui, l'instance s'arrête au repos
#      et le disque Replit étant volatile, un réappairage sera nécessaire.
#
# ⚠ Jamais deux instances en parallèle : un seul Run à la fois.
modules = ["nodejs-22", "web"]
run = "npm start"
entrypoint = "node index.js"
hidden = ["node_modules", "sessions", "data", "logs", "downloads"]
