# Variables d'environnement du projet VERCEL (site + fonctions api/).
# A renseigner dans Vercel : Project > Settings > Environment Variables
# (cocher Production ET Preview). Ne jamais mettre de valeur reelle dans ce fichier.

# URL publique HTTPS du service Render (sans chemin, sans slash final)
PAIRING_API_URL=https://djousse-tech-md.onrender.com

# Meme valeur que PAIRING_API_TOKEN cote Render (Render > Environment)
PAIRING_API_TOKEN=

# NE PAS DEFINIR SITE_ORIGIN (optionnel) : l'origine est deduite de la requete,
# ce qui fonctionne pour la production, les previews et un domaine personnalise.
